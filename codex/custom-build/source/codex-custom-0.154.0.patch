+use super::*;
+use crossterm::event::MouseButton;
+use crossterm::event::MouseEventKind;
+use pretty_assertions::assert_eq;
+
+fn draw(tui: &mut Tui, width: u16) {
+    tui.draw_with_resize_reflow(/*height*/ 2, Size::new(width, /*height*/ 8), |frame| {
+        Paragraph::new("prompt\nstatus").render(frame.area(), frame.buffer_mut());
+    })
+    .unwrap();
+}
+
+fn contents(tui: &Tui) -> String {
+    let buffer = tui.last_drawn_viewport.as_ref().unwrap();
+    buffer
+        .content
+        .chunks(usize::from(buffer.area.width))
+        .map(|row| {
+            row.iter()
+                .map(Cell::symbol)
+                .collect::<String>()
+                .trim_end()
+                .to_string()
+        })
+        .collect::<Vec<_>>()
+        .join("\n")
+}
+
+fn mouse(tui: &mut Tui, kind: MouseEventKind, x: u16, y: u16, copied: &mut Vec<String>) -> bool {
+    tui.handle_text_selection_mouse_event_with(
+        MouseEvent {
+            kind,
+            column: x,
+            row: y,
+            modifiers: crossterm::event::KeyModifiers::NONE,
+        },
+        |text| {
+            copied.push(text.to_string());
+            Ok(None)
+        },
+    )
+}
+
+#[tokio::test]
+async fn scrolling_selects_visible_rows_and_retains_position_during_output() {
+    let mut tui = test_support::make_test_tui().unwrap();
+    tui.conversation_screen = Some(ConversationScreen::default());
+    tui.insert_history_lines(
+        (0..12)
+            .map(|index| Line::from(format!("row {index:02}")))
+            .collect(),
+    );
+    draw(&mut tui, 20);
+    insta::assert_snapshot!(contents(&tui), @"
+    row 06
+    row 07
+    row 08
+    row 09
+    row 10
+    row 11
+    prompt
+    status
+    ");
+    tui.scroll_conversation(MouseEventKind::ScrollUp);
+    draw(&mut tui, 20);
+    let scrolled = contents(&tui);
+    assert!(scrolled.starts_with("row 03\n"));
+    assert_eq!(
+        tui.history_tail_row_index_at_screen_row(/*screen_row*/ 0),
+        Some(3)
+    );
+    let mut copied = Vec::new();
+    for kind in [
+        MouseEventKind::Down(MouseButton::Left),
+        MouseEventKind::Drag(MouseButton::Left),
+        MouseEventKind::Up(MouseButton::Left),
+    ] {
+        let x = if matches!(kind, MouseEventKind::Down(_)) {
+            0
+        } else {
+            5
+        };
+        mouse(&mut tui, kind, x, 0, &mut copied);
+        draw(&mut tui, 20);
+    }
+    assert_eq!(copied, ["row 03"]);
+    tui.insert_history_lines(vec!["new output".into()]);
+    draw(&mut tui, 20);
+    assert_eq!(contents(&tui), scrolled);
+    tui.clear_text_selection();
+    draw(&mut tui, 20);
+    assert_eq!(contents(&tui), scrolled);
+    for _ in 0..3 {
+        tui.scroll_conversation(MouseEventKind::ScrollDown);
+    }
+    draw(&mut tui, 20);
+    assert!(contents(&tui).contains("row 11\nnew output\nprompt"));
+}
+
+#[tokio::test]
+async fn repeated_clicks_and_tail_replacement_share_the_rendered_row_mapping() {
+    let mut tui = test_support::make_test_tui().unwrap();
+    tui.conversation_screen = Some(ConversationScreen::default());
+    let original = vec![
+        Line::from("patch A"),
+        Line::from("  A detail"),
+        Line::from("patch B"),
+        Line::from("  B detail"),
+    ];
+    tui.insert_history_lines(original.clone());
+    draw(&mut tui, 20);
+    let mut copied = Vec::new();
+    for (row, index) in [(2, 0), (4, 2), (2, 0)] {
+        assert!(!mouse(
+            &mut tui,
+            MouseEventKind::Down(MouseButton::Left),
+            0,
+            row,
+            &mut copied
+        ));
+        assert!(mouse(
+            &mut tui,
+            MouseEventKind::Up(MouseButton::Left),
+            0,
+            row,
+            &mut copied
+        ));
+        assert_eq!(tui.history_tail_row_index_at_screen_row(row), Some(index));
+        draw(&mut tui, 20);
+    }
+    assert!(copied.is_empty());
+    let previous = original
+        .into_iter()
+        .map(HyperlinkLine::new)
+        .collect::<Vec<_>>();
+    assert!(
+        tui.replace_visible_history_tail(
+            &previous,
+            &["patch A folded".into(), "patch B folded".into()],
