+fn is_transcript_encoded_payload_byte(byte: u8) -> bool {
+    byte.is_ascii_alphanumeric() || matches!(byte, b'+' | b'/' | b'=' | b'_' | b'-')
+}
+
+fn elide_transcript_encoded_payloads(line: &str) -> Option<String> {
+    let bytes = line.as_bytes();
+    let mut output: Option<String> = None;
+    let mut preserved_until = 0;
+    let mut cursor = 0;
+
+    while cursor < bytes.len() {
+        while cursor < bytes.len() && !is_transcript_encoded_payload_byte(bytes[cursor]) {
+            cursor += 1;
+        }
+        let start = cursor;
+        while cursor < bytes.len() && is_transcript_encoded_payload_byte(bytes[cursor]) {
+            cursor += 1;
+        }
+        let end = cursor;
+        let encoded_len = end.saturating_sub(start);
+        let encoded_symbols = bytes[start..end]
+            .iter()
+            .filter(|byte| matches!(**byte, b'+' | b'/' | b'=' | b'_' | b'-'))
+            .count();
+
+        if encoded_len >= TRANSCRIPT_ENCODED_RUN_MIN_BYTES
+            && encoded_symbols >= TRANSCRIPT_ENCODED_RUN_MIN_SYMBOLS
+        {
+            let output = output.get_or_insert_with(|| String::with_capacity(line.len().min(512)));
+            output.push_str(&line[preserved_until..start]);
+            output.push_str(&format!(
+                "[… {encoded_len} bytes of encoded payload omitted …]"
+            ));
+            preserved_until = end;
+        }
+    }
+
+    output.map(|mut output| {
+        output.push_str(&line[preserved_until..]);
+        output
+    })
+}
+
+fn floor_char_boundary(input: &str, byte_index: usize) -> usize {
+    let mut boundary = byte_index.min(input.len());
+    while boundary > 0 && !input.is_char_boundary(boundary) {
+        boundary -= 1;
+    }
+    boundary
+}
+
+fn ceil_char_boundary(input: &str, byte_index: usize) -> usize {
+    let mut boundary = byte_index.min(input.len());
+    while boundary < input.len() && !input.is_char_boundary(boundary) {
+        boundary += 1;
+    }
+    boundary
+}
+
+fn has_many_escaped_newlines(line: &str) -> bool {
+    line.match_indices("\\n")
+        .nth(TRANSCRIPT_ESCAPED_NEWLINE_MIN_OCCURRENCES.saturating_sub(1))
+        .is_some()
+}
+
+fn elide_transcript_oversized_line(line: &str) -> Option<String> {
+    if line.len() <= TRANSCRIPT_MAX_LOGICAL_LINE_BYTES {
+        return None;
+    }
+
+    if has_many_escaped_newlines(line) {
+        return Some(format!(
+            "[… {} bytes of escaped structured transcript payload omitted …]",
+            line.len()
+        ));
+    }
+
+    let head_end = floor_char_boundary(line, TRANSCRIPT_LONG_LINE_HEAD_BYTES);
+    let tail_start = ceil_char_boundary(
+        line,
+        line.len().saturating_sub(TRANSCRIPT_LONG_LINE_TAIL_BYTES),
+    );
+    let omitted_bytes = tail_start.saturating_sub(head_end);
+    Some(format!(
+        "{}[… {omitted_bytes} bytes omitted from oversized transcript line …]{}",
+        &line[..head_end],
+        &line[tail_start..]
+    ))
+}
+
+fn sanitize_transcript_line(line: &str) -> Option<String> {
+    let encoded_payload_elided = elide_transcript_encoded_payloads(line);
+    let source = encoded_payload_elided.as_deref().unwrap_or(line);
+    elide_transcript_oversized_line(source).or(encoded_payload_elided)
+}
