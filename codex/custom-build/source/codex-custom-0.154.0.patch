diff --git a/codex-rs/tui/src/tui_selection_pty_tests.rs b/codex-rs/tui/src/tui_selection_pty_tests.rs
new file mode 100644
index 0000000..b7f0d46
--- /dev/null
+++ b/codex-rs/tui/src/tui_selection_pty_tests.rs
@@ -0,0 +1,283 @@
+//! Exercise real SGR mouse input, the event broker, inline rendering and visible history selection.
+//! No model session or real clipboard is created; the clipboard sink records the selected text.
+
+use std::fs::File;
+use std::io::Read;
+use std::io::Write;
+use std::os::fd::AsRawFd;
+use std::os::fd::FromRawFd;
+use std::path::Path;
+use std::process::Command;
+use std::process::Stdio;
+use std::time::Duration;
+use std::time::Instant;
+
+use pretty_assertions::assert_eq;
+
+#[test]
+fn repeated_history_drags_render_and_copy_through_a_pty() {
+    run_history_drag_test("reflow");
+}
+
+#[test]
+fn repeated_history_drags_render_and_copy_through_a_legacy_pty() {
+    run_history_drag_test("legacy");
+}
+
+#[expect(
+    clippy::expect_used,
+    reason = "PTY test setup and I/O failures must fail the test"
+)]
+fn run_history_drag_test(render_path: &str) {
+    let mut master = -1;
+    let mut slave = -1;
+    let size = libc::winsize {
+        ws_row: 24,
+        ws_col: 80,
+        ws_xpixel: 0,
+        ws_ypixel: 0,
+    };
+    // Safety: openpty writes valid owned descriptors and only reads the supplied size.
+    assert_eq!(
+        unsafe {
+            libc::openpty(
+                &mut master,
+                &mut slave,
+                std::ptr::null_mut(),
+                std::ptr::null(),
+                &size,
+            )
+        },
+        0
+    );
+    // Safety: the successful openpty call returned these owned descriptors.
+    let mut master = unsafe { File::from_raw_fd(master) };
+    let slave = unsafe { File::from_raw_fd(slave) };
+    // Safety: fcntl changes only our test PTY's nonblocking flag.
+    unsafe {
+        libc::fcntl(master.as_raw_fd(), libc::F_SETFL, libc::O_NONBLOCK);
+    }
+    let dir = tempfile::tempdir().expect("create PTY synchronization directory");
+    let mut child = Command::new(std::env::current_exe().expect("find test executable"))
+        .args([
+            "--exact",
+            "tui::selection_pty_tests::mouse_selection_pty_child",
+            "--ignored",
+            "--nocapture",
+        ])
+        .env("CODEX_SELECTION_PTY_TEST", dir.path())
+        .env("CODEX_SELECTION_RENDER_PATH", render_path)
+        .env("TERM", "xterm-256color")
+        .stdin(Stdio::from(slave.try_clone().expect("clone PTY slave")))
+        .stdout(Stdio::from(slave))
+        .stderr(Stdio::piped())
+        .spawn()
+        .expect("start PTY test child");
+    let mut parser = vt100::Parser::new(
+        /*rows*/ 24, /*cols*/ 80, /*scrollback_len*/ 100,
+    );
+    let result = (|| -> Result<(), String> {
+        wait_and_drain(&dir.path().join("ready"), &mut master, &mut parser)?;
+        let rows: Vec<u16> = serde_json::from_slice(
+            &std::fs::read(dir.path().join("ready")).expect("read history coordinates"),
+        )
+        .expect("decode history coordinates");
+        let original_screen = parser.screen().contents();
+        for (gesture, row) in rows.into_iter().enumerate() {
+            for (step, (button, col, suffix)) in [(0, 3, 'M'), (32, 7, 'M'), (0, 7, 'm')]
+                .into_iter()
+                .enumerate()
+            {
+                write!(master, "\x1b[<{button};{col};{}{suffix}", row + 1)
+                    .expect("send mouse report");
+                wait_and_drain(
+                    &dir.path().join(format!("step-{}", gesture * 3 + step + 1)),
+                    &mut master,
+                    &mut parser,
+                )?;
+                assert_eq!(
+                    parser.screen().contents(),
+                    original_screen,
+                    "selection must preserve all displayed characters"
+                );
+                if step > 0
+                    && !parser
+                        .screen()
+                        .cell(row, 2)
+                        .expect("history cell")
+                        .inverse()
+                {
+                    return Err(format!(
+                        "drag {gesture}, step {step}: history selection is invisible at row {row}"
+                    ));
+                }
+            }
+            let expected = if gesture == 0 { "alpha" } else { "bravo" };
+            assert_eq!(
+                std::fs::read_to_string(dir.path().join("clipboard"))
+                    .expect("read copied selection"),
+                expected
+            );
+            if gesture == 1 {
+                let first_row: Vec<u16> = serde_json::from_slice(
+                    &std::fs::read(dir.path().join("ready"))
+                        .expect("read first history coordinate"),
+                )
+                .expect("decode first history coordinate");
+                assert!(
+                    !parser
+                        .screen()
+                        .cell(first_row[0], 2)
+                        .expect("first history cell")
+                        .inverse()
+                );
+            }
+        }
+        master.write_all(b"\x1b[1;5F").expect("send Ctrl+End");
+        wait_and_drain(&dir.path().join("released"), &mut master, &mut parser)?;
+        assert!(
+            parser
+                .screen()
+                .contents()
+                .contains("fresh output after reflow")
+        );
+        assert!(!parser.screen().contents().contains("alpha history"));
+        master.write_all(b"q").expect("finish PTY input loop");
+        wait_and_drain(&dir.path().join("done"), &mut master, &mut parser)?;
+        Ok(())
+    })();
+    if result.is_err() {
+        let _ = child.kill();
+    }
+    let output = child.wait_with_output().expect("collect PTY test child");
+    assert!(
+        result.is_ok(),
+        "{result:?}; child stderr: {}",
+        String::from_utf8_lossy(&output.stderr)
+    );
+    assert!(
+        output.status.success(),
+        "{}",
+        String::from_utf8_lossy(&output.stderr)
+    );
+}
+
+fn wait_and_drain(
+    path: &Path,
+    master: &mut File,
+    parser: &mut vt100::Parser,
+) -> Result<(), String> {
+    let started = Instant::now();
+    loop {
+        let ready = path.exists();
+        let mut buf = [0; 16384];
+        loop {
+            match master.read(&mut buf) {
+                Ok(0) => break,
+                Ok(n) => parser.process(&buf[..n]),
+                Err(error) if error.kind() == std::io::ErrorKind::WouldBlock => break,
+                Err(error) if error.raw_os_error() == Some(libc::EIO) => break,
+                Err(error) => return Err(error.to_string()),
+            }
+        }
+        if ready {
+            return Ok(());
+        }
+        if started.elapsed() > Duration::from_secs(/*secs*/ 15) {
+            return Err(format!("timed out waiting for {}", path.display()));
+        }
+        std::thread::sleep(Duration::from_millis(/*millis*/ 5));
+    }
+}
+
+#[tokio::test(flavor = "current_thread")]
+#[ignore = "invoked by the parent test with a private PTY"]
+async fn mouse_selection_pty_child() {
+    use ratatui::layout::Position;
+    use ratatui::layout::Rect;
+    use ratatui::layout::Size;
+    use ratatui::text::Line;
+    use ratatui::widgets::Paragraph;
+    use ratatui::widgets::Widget;
+    use tokio_stream::StreamExt;
+
+    let Some(dir) = std::env::var_os("CODEX_SELECTION_PTY_TEST") else {
+        return;
+    };
+    let dir = std::path::PathBuf::from(dir);
+    super::set_modes().unwrap();
+    crate::terminal_palette::set_default_colors_from_startup_probe(/*colors*/ None);
+    let mut tui = super::test_support::make_test_tui().unwrap();
+    tui.enable_conversation_screen().unwrap();
+    let size = Size::new(/*width*/ 80, /*height*/ 24);
+    tui.terminal.set_viewport_area(Rect::new(
+        /*x*/ 0, /*y*/ 22, /*width*/ 80, /*height*/ 2,
+    ));
+    tui.insert_history_lines(vec![
+        Line::from("  alpha history"),
+        Line::from("  bravo history"),
+    ]);
+    let legacy = std::env::var("CODEX_SELECTION_RENDER_PATH").unwrap() == "legacy";
+    let draw = |tui: &mut super::Tui| {
+        let render = |frame: &mut crate::custom_terminal::Frame| {
+            let area = frame.area();
+            Paragraph::new("  prompt").render(area, frame.buffer_mut());
+            frame.set_cursor_position(Position::new(/*x*/ 2, area.y));
+        };
+        if legacy {
+            tui.draw(/*height*/ 2, render).unwrap();
+        } else {
+            tui.draw_with_resize_reflow(/*height*/ 2, size, render)
+                .unwrap();
+        }
+    };
+    draw(&mut tui);
+    let surface = tui.selection_surface().unwrap();
+    let rows: Vec<u16> = (0..22)
+        .filter(|&row| surface[(2, row)].symbol() == "a" || surface[(2, row)].symbol() == "b")
+        .collect();
+    assert_eq!(rows.len(), 2);
+    std::fs::write(dir.join("ready"), serde_json::to_vec(&rows).unwrap()).unwrap();
+    let mut events = tui.event_stream();
+    let mut step = 0;
+    while let Some(event) = events.next().await {
+        match event {
+            super::TuiEvent::Mouse(mouse) => {
+                tui.handle_text_selection_mouse_event_with(mouse, |text| {
+                    std::fs::write(dir.join("clipboard"), text).unwrap();
+                    Ok(None)
+                });
+                if step == 1 {
+                    let previous = vec![
+                        Line::from("  alpha history").into(),
+                        Line::from("  bravo history").into(),
+                    ];
+                    let replacement = vec![Line::from("  latest assistant prose").into()];
+                    assert!(
+                        tui.replace_visible_history_tail(
+                            &previous,
+                            &replacement,
+                            crate::insert_history::HistoryLineWrapPolicy::PreWrap
+                        )
+                        .unwrap()
+                    );
+                    tui.clear_pending_history_lines();
+                    tui.insert_history_lines(vec![Line::from("  fresh output after reflow")]);
+                }
+                draw(&mut tui);
+                step += 1;
+                std::fs::write(dir.join(format!("step-{step}")), []).unwrap();
+            }
+            super::TuiEvent::Draw => draw(&mut tui),
+            super::TuiEvent::Key(key) if tui.handle_conversation_key_event(key) => {
+                draw(&mut tui);
+                std::fs::write(dir.join("released"), []).unwrap();
+            }
+            super::TuiEvent::Key(_) => break,
+            _ => {}
+        }
+    }
+    tui.clear_text_selection();
+    super::restore().unwrap();
+    std::fs::write(dir.join("done"), []).unwrap();
+}
