+//! Styled printer output for finalized assistant statement cards.
+//!
+//! The TUI transcript owns assistant responses as source-backed
+//! [`AgentMarkdownCell`] values. This module selects only those finalized cards,
+//! renders their Markdown to self-contained HTML, and sends the resulting document
+//! to a local print backend. It deliberately never scrapes terminal rows, so tool
+//! output, status lines, and terminal presentation cannot leak into a print job.
+
+use std::ffi::OsStr;
+use std::io::Write;
+use std::path::Path;
+use std::path::PathBuf;
+use std::process::Command;
+use std::process::Stdio;
+use std::sync::Arc;
+
+use super::App;
+use crate::history_cell::AgentMarkdownCell;
+use crate::history_cell::HistoryCell;
+
+const PRINT_DIRECTORY: &str = "printouts";
+const WINDOWS_PRINT_SCRIPT: &str = r#"
+[Console]::InputEncoding = [System.Text.Encoding]::UTF8
+$ErrorActionPreference = 'Stop'
+$documentPath = [Console]::In.ReadToEnd().Trim()
+if ([String]::IsNullOrWhiteSpace($documentPath)) { throw 'No print document path was received.' }
+$defaultPrinter = Get-CimInstance Win32_Printer | Where-Object { $_.Default } | Select-Object -First 1
+if ($null -eq $defaultPrinter) { throw 'No default Windows printer is configured.' }
+if (-not (Test-Path -LiteralPath $documentPath -PathType Leaf)) {
+  throw "Print document was not found: $documentPath"
+}
+
+# Use the Windows HTML renderer directly. `Start-Process -Verb Print` depends on
+# the user's shell file association and fails when HTML has no registered Print verb.
+Add-Type -AssemblyName System.Windows.Forms
+$state = [PSCustomObject]@{ Completed = $false; Error = $null }
+$form = [System.Windows.Forms.Form]::new()
+$form.StartPosition = [System.Windows.Forms.FormStartPosition]::Manual
+$form.Location = [System.Drawing.Point]::new(-32000, -32000)
+$form.Size = [System.Drawing.Size]::new(1, 1)
+$form.ShowInTaskbar = $false
+$form.FormBorderStyle = [System.Windows.Forms.FormBorderStyle]::None
+$form.Opacity = 0
+
+$browser = [System.Windows.Forms.WebBrowser]::new()
+$browser.ScriptErrorsSuppressed = $true
+$browser.Dock = [System.Windows.Forms.DockStyle]::Fill
+$form.Controls.Add($browser)
+
+$timeout = [System.Windows.Forms.Timer]::new()
+$timeout.Interval = 30000
+$timeout.Add_Tick({
+  $timeout.Stop()
+  $state.Error = 'timed out waiting for the Windows HTML renderer'
+  $form.Close()
+})
+
+# Keep the hidden renderer alive briefly after dispatching the job so it can hand
+# the fully rendered page to the Windows print spooler before its host exits.
+$settle = [System.Windows.Forms.Timer]::new()
+$settle.Interval = 1200
+$settle.Add_Tick({
+  $settle.Stop()
+  $form.Close()
+})
+
+$browser.Add_DocumentCompleted({
+  if ($state.Completed) { return }
+  $state.Completed = $true
+  $timeout.Stop()
+  try {
+    $browser.Print()
+    $settle.Start()
+  } catch {
+    $state.Error = $_.Exception.Message
+    $form.Close()
+  }
+})
+
+$form.Add_Shown({
+  $timeout.Start()
+  $browser.Navigate($documentPath)
+})
+[System.Windows.Forms.Application]::Run($form)
+if ($null -ne $state.Error) { throw "Windows HTML printing failed: $($state.Error)" }
+if (-not $state.Completed) { throw 'Windows HTML renderer did not complete.' }
+"#;
