+fn selected_text_from_buffer(selection: TextSelection, buffer: &Buffer) -> Option<String> {
+    if !selection.dragged || buffer.area.width == 0 || buffer.area.height == 0 {
+        return None;
+    }
+
+    let (mut start, mut end) = selection.ordered_bounds();
+    let area = buffer.area;
+    let max_x = area.right().saturating_sub(1);
+    let max_y = area.bottom().saturating_sub(1);
+    start.x = start.x.clamp(area.left(), max_x);
+    end.x = end.x.clamp(area.left(), max_x);
+    start.y = start.y.clamp(area.top(), max_y);
+    end.y = end.y.clamp(area.top(), max_y);
+    if (start.y, start.x) > (end.y, end.x) {
+        return None;
+    }
+
+    let mut lines = Vec::new();
+    for y in start.y..=end.y {
+        let first_column = if y == start.y { start.x } else { area.left() };
+        let last_column = if y == end.y { end.x } else { max_x };
+        let mut line = String::new();
+        let mut x = first_column;
+        while x <= last_column {
+            let cell = &buffer[(x, y)];
+            line.push_str(&crate::terminal_hyperlinks::strip_osc8(cell.symbol()));
+            let width = cell.cell_width().max(1);
+            x = x.saturating_add(width);
+            if x == 0 {
+                break;
+            }
+        }
+        lines.push(line.trim_end().to_string());
+    }
+    let text = lines.join("\n");
+    (!text.trim().is_empty()).then_some(text)
+}
