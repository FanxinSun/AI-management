+#[test]
+fn command_output_is_one_complete_shaded_panel_even_when_scrolled() {
+    let cell = command_cell();
+    for width in [24, 72] {
+        let lines = cell.transcript_hyperlink_lines(width);
+        let full = buffer_for(&lines, width, lines.len() as u16, /*scroll*/ 0);
+        let scrolled = buffer_for(&lines, width, /*height*/ 5, /*scroll*/ 5);
+        let command_column = lines
+            .iter()
+            .find_map(|line| line.line.to_string().find("$ ").map(|column| column + 2))
+            .unwrap();
+        let output_start = lines
+            .iter()
+            .position(|line| line.line.to_string().contains("warning:"))
+            .unwrap();
+        for line in &lines[output_start..] {
+            let text = line.line.to_string();
+            if !text.trim().is_empty() {
+                assert!(
+                    text.len() - text.trim_start().len() >= command_column,
+                    "output/status outdents command at width {width}: {text:?}"
+                );
+            }
+        }
+        for y in 0..full.area.height {
+            for x in 0..width {
+                assert_eq!(
+                    full[(x, y)].bg != Color::Reset,
+                    (2..width - 2).contains(&x),
+                    "panel coverage at {x},{y} in width {width}"
+                );
+            }
+        }
+        for y in 0..5 {
+            for x in 0..width {
+                assert_eq!(scrolled[(x, y)], full[(x, y + 5)]);
+            }
+        }
+        insta::assert_snapshot!(format!("complete_command_panel_{width}"), snapshot(&full));
+    }
