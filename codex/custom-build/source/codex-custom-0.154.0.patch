+
+    buffer
+        .content
+        .chunks(usize::from(width))
+        .map(<[Cell]>::to_vec)
+        .collect()
+}
+
+fn append_selection_history_rows(
+    history_rows: &mut VecDeque<Vec<Cell>>,
+    history_width: &mut Option<u16>,
+    lines: &[HyperlinkLine],
+    wrap_policy: HistoryLineWrapPolicy,
+    width: u16,
+) {
+    if *history_width != Some(width) {
+        history_rows.clear();
+        *history_width = Some(width);
+    }
+    for row in selection_history_rows(lines, wrap_policy, width) {
+        history_rows.push_back(row);
+    }
+    while history_rows.len() > TEXT_SELECTION_HISTORY_ROW_LIMIT {
+        history_rows.pop_front();
+    }
+}
+
+fn append_row(buffer: &mut Buffer, y: u16, row: &[Cell]) {
+    if y < buffer.area.top() || y >= buffer.area.bottom() {
+        return;
+    }
+    let width = usize::from(buffer.area.width).min(row.len());
+    let start = usize::from(y - buffer.area.y) * usize::from(buffer.area.width);
+    buffer.content[start..start + width].clone_from_slice(&row[..width]);
+}
+
+fn append_buffer(buffer: &mut Buffer, source: &Buffer) {
+    let left = source.area.left().max(buffer.area.left());
+    let right = source.area.right().min(buffer.area.right());
+    let top = source.area.top().max(buffer.area.top());
+    let bottom = source.area.bottom().min(buffer.area.bottom());
+    for y in top..bottom {
+        for x in left..right {
+            buffer[(x, y)] = source[(x, y)].clone();
+        }
+    }
+}
