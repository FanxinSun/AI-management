+
+/// Resolve a row in the bounded terminal-history cache against a source-backed row target list.
+///
+/// The cache may contain a clear-screen header or omit older source rows, so align the two lists
+/// at their newest edge. That is the same edge the inline terminal viewport exposes above the
+/// composer.
+fn tail_aligned_history_target(
+    source_targets: &[Option<usize>],
+    cached_row_count: usize,
+    cached_row: usize,
+) -> Option<usize> {
+    if cached_row >= cached_row_count {
+        return None;
+    }
+
+    if source_targets.len() >= cached_row_count {
+        let source_row = source_targets.len() - cached_row_count + cached_row;
+        return source_targets.get(source_row).copied().flatten();
+    }
+
+    let uncategorized_prefix = cached_row_count - source_targets.len();
+    cached_row
+        .checked_sub(uncategorized_prefix)
+        .and_then(|source_row| source_targets.get(source_row).copied().flatten())
+}
