+    );
+    draw(&mut tui, 20);
+    assert_eq!(
+        tui.history_tail_row_index_at_screen_row(/*screen_row*/ 4),
+        Some(0)
+    );
+    assert_eq!(
+        tui.history_tail_row_index_at_screen_row(/*screen_row*/ 5),
+        Some(1)
+    );
+    assert!(contents(&tui).ends_with("patch A folded\npatch B folded\nprompt\nstatus"));
+}
+
+#[tokio::test]
+async fn resize_and_transcript_view_restore_current_content_without_stale_selection() {
+    let mut tui = test_support::make_test_tui().unwrap();
+    tui.conversation_screen = Some(ConversationScreen::default());
+    tui.insert_history_lines(vec!["current conversation".into()]);
+    draw(&mut tui, 24);
+    let mut copied = Vec::new();
+    mouse(
+        &mut tui,
+        MouseEventKind::Down(MouseButton::Left),
+        0,
+        5,
+        &mut copied,
+    );
+    mouse(
+        &mut tui,
+        MouseEventKind::Drag(MouseButton::Left),
+        6,
+        5,
+        &mut copied,
+    );
+    draw(&mut tui, 24);
+    tui.clear_pending_history_lines();
+    tui.insert_history_lines(vec!["new size".into()]);
+    draw(&mut tui, 12);
+    assert!(tui.text_selection.is_none());
+    assert!(contents(&tui).ends_with("new size\nprompt\nstatus"));
+    tui.enter_alt_screen().unwrap();
+    tui.draw_with_resize_reflow(8, Size::new(12, 8), |frame| {
+        Paragraph::new("transcript").render(frame.area(), frame.buffer_mut());
+    })
+    .unwrap();
+    assert!(contents(&tui).starts_with("transcript"));
+    tui.leave_alt_screen().unwrap();
+    draw(&mut tui, 12);
+    assert!(contents(&tui).ends_with("new size\nprompt\nstatus"));
+}
+
+#[tokio::test]
+async fn selecting_linked_wide_text_copies_visible_text_and_preserves_cell_widths() {
+    let mut tui = test_support::make_test_tui().unwrap();
+    tui.conversation_screen = Some(ConversationScreen::default());
+    let mut line = HyperlinkLine::default();
+    line.push_span("界link".into(), Some("https://example.com"));
+    tui.insert_history_hyperlink_lines_with_wrap_policy(vec![line], HistoryLineWrapPolicy::PreWrap);
+    draw(&mut tui, 20);
+    let before = tui.last_drawn_viewport.as_ref().unwrap()[(0, 5)].clone();
+    assert_eq!(before.cell_width(), 2);
+    let mut copied = Vec::new();
+    mouse(
+        &mut tui,
+        MouseEventKind::Down(MouseButton::Left),
+        0,
+        5,
+        &mut copied,
+    );
+    mouse(
+        &mut tui,
+        MouseEventKind::Drag(MouseButton::Left),
+        5,
+        5,
+        &mut copied,
+    );
+    draw(&mut tui, 20);
+    mouse(
+        &mut tui,
+        MouseEventKind::Up(MouseButton::Left),
