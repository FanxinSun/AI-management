+/// Render the configurable status line as up to two rows.
+///
+/// The first two configured values form the primary row (normally thread name
+/// and model); any remaining values form the secondary row (normally folder,
+/// permissions, approval mode, and usage limits). Keeping the split here means
+/// both rows use the same theme-derived colors and separators as the one-line
+/// status preview.
+pub(crate) fn status_lines_from_segments<I>(
+    segments: I,
+    use_theme_colors: bool,
+) -> Vec<Line<'static>>
+where
+    I: IntoIterator<Item = (StatusLineItem, String)>,
+{
+    status_lines_from_segments_with_resolver(segments, use_theme_colors, |accent| {
+        foreground_style_for_scopes(accent.scopes())
+    })
+}
+
+fn status_lines_from_segments_with_resolver<I, F>(
+    segments: I,
+    use_theme_colors: bool,
+    theme_style_for_accent: F,
+) -> Vec<Line<'static>>
+where
+    I: IntoIterator<Item = (StatusLineItem, String)>,
+    F: Fn(StatusLineAccent) -> Option<Style>,
+{
+    let mut primary_spans = Vec::new();
+    let mut secondary_spans = Vec::new();
+    for (item, text) in segments {
+        let row = if status_line_primary_row_item(item) {
+            &mut primary_spans
+        } else {
+            &mut secondary_spans
+        };
+        push_status_line_segment(row, item, text, use_theme_colors, &theme_style_for_accent);
+    }
+
+    [primary_spans, secondary_spans]
+        .into_iter()
+        .filter_map(line_from_status_spans)
+        .collect()
+}
