+    if lines.is_empty() || width == 0 {
+        return Vec::new();
+    }
+
+    let (wrapped, _) = wrap_history_hyperlink_lines(lines, usize::from(width), wrap_policy);
+    if wrapped.is_empty() {
+        return Vec::new();
+    }
+
+    let paragraph = Paragraph::new(
