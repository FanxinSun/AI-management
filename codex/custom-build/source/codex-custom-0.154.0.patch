+impl Tui {
+    pub(crate) fn enable_conversation_screen(&mut self) -> Result<()> {
+        if self.conversation_screen.is_some() || !self.alt_screen_enabled {
+            return Ok(());
+        }
+        execute!(self.terminal.backend_mut(), EnterAlternateScreen)?;
+        self.alt_screen_active.store(true, Ordering::Relaxed);
+        self.conversation_screen = Some(ConversationScreen::default());
+        self.terminal.clear()?;
+        self.restore_click_capture_after_input();
+        Ok(())
+    }
+
+    pub(crate) fn owns_conversation_screen(&self) -> bool {
+        self.conversation_screen.is_some()
+    }
+
+    pub(crate) fn history_viewport_top(&self) -> u16 {
+        self.conversation_screen
+            .as_ref()
+            .map_or(self.terminal.viewport_area.top(), |screen| {
+                screen.history_area.bottom()
+            })
+    }
+
+    pub(super) fn flush_conversation_history(&mut self) {
+        let width = self.terminal.last_known_screen_size.width.max(1);
+        if !self.pending_history_lines.is_empty()
+            && let Some(screen) = &mut self.conversation_screen
+        {
+            screen.history_revision = screen.history_revision.wrapping_add(1);
+        }
+        let previous_count = self.selection_history_rows.len();
+        let mut added = 0;
+        for batch in self.pending_history_lines.drain(..) {
+            let rows = selection_history_rows(&batch.lines, batch.wrap_policy, width);
+            if self.selection_history_width != Some(width) {
+                self.selection_history_rows.clear();
+                self.selection_history_width = Some(width);
+            }
+            added += rows.len();
+            self.selection_history_rows.extend(rows);
+        }
+        while self.selection_history_rows.len() > TEXT_SELECTION_HISTORY_ROW_LIMIT {
+            self.selection_history_rows.pop_front();
+        }
+        if let Some(screen) = &mut self.conversation_screen
+            && screen.offset != 0
+            && previous_count != 0
+        {
+            screen.offset = screen.offset.saturating_add(added);
+        }
+    }
+
+    /// Return to the live conversation tail, including output received during selection.
+    pub(crate) fn handle_conversation_key_event(&mut self, key: KeyEvent) -> bool {
+        if key.code != KeyCode::End
+            || key.modifiers != KeyModifiers::CONTROL
+            || !matches!(key.kind, KeyEventKind::Press | KeyEventKind::Repeat)
+            || self
+                .conversation_screen
+                .as_ref()
+                .is_none_or(|screen| screen.overlay)
+        {
+            return false;
+        }
+        self.clear_text_selection();
+        if let Some(screen) = &mut self.conversation_screen {
+            screen.offset = 0;
+        }
+        self.frame_requester().schedule_frame();
+        true
+    }
+
+    pub(crate) fn scroll_conversation(&mut self, kind: crossterm::event::MouseEventKind) {
+        self.clear_text_selection();
+        let Some(screen) = &mut self.conversation_screen else {
+            return;
+        };
+        let max_offset = self
+            .selection_history_rows
+            .len()
+            .saturating_sub(usize::from(screen.history_area.height));
+        screen.offset = match kind {
+            crossterm::event::MouseEventKind::ScrollUp => {
+                screen.offset.saturating_add(3).min(max_offset)
+            }
+            crossterm::event::MouseEventKind::ScrollDown => screen.offset.saturating_sub(3),
+            _ => screen.offset,
+        };
+        self.frame_requester().schedule_frame();
+    }
+
+    pub(super) fn draw_conversation_screen(
+        &mut self,
+        height: u16,
+        screen_size: Size,
+        draw_fn: impl FnOnce(&mut custom_terminal::Frame),
+    ) -> Result<()> {
+        ensure_virtual_terminal_processing()?;
+        #[cfg(unix)]
+        let mut resume = self
+            .suspend_context
+            .prepare_resume_action(&mut self.alt_saved_viewport);
+        stdout().sync_update(|_| {
+            #[cfg(unix)]
+            if let Some(prepared) = resume.take() {
+                prepared.apply(&mut self.terminal, screen_size)?;
+            }
+            self.terminal.last_known_screen_size = screen_size;
+            self.flush_conversation_history();
+            let full = Rect::new(
+                /*x*/ 0,
+                /*y*/ 0,
+                screen_size.width,
+                screen_size.height,
+            );
+            self.terminal.set_viewport_area(full);
+            let Some(screen) = self.conversation_screen.as_mut() else {
+                return Ok(());
+            };
+            if screen
+                .frozen
+                .as_ref()
+                .is_some_and(|buffer| buffer.area != full)
+            {
+                screen.frozen = None;
+                self.text_selection = None;
+            }
+            let composer_height = height.min(full.height);
+            let history_height = if screen.overlay {
+                0
+            } else {
+                full.height - composer_height
+            };
+            screen.history_area = Rect::new(/*x*/ 0, /*y*/ 0, full.width, history_height);
+            let composer = Rect::new(
+                /*x*/ 0,
+                history_height,
+                full.width,
+                full.height - history_height,
+            );
+            let row_count = self.selection_history_rows.len();
+            screen.offset = screen
+                .offset
+                .min(row_count.saturating_sub(usize::from(history_height)));
+            let end = row_count.saturating_sub(screen.offset);
+            let start = end.saturating_sub(usize::from(history_height));
+            let destination = usize::from(history_height).saturating_sub(end - start);
+            let mut unselected = None;
+            self.terminal.draw_with_size(screen_size, |frame| {
+                for (index, row) in self
+                    .selection_history_rows
+                    .iter()
+                    .skip(start)
+                    .take(end - start)
+                    .enumerate()
+                {
+                    append_row(frame.buffer_mut(), (destination + index) as u16, row);
+                }
+                frame.viewport_area = composer;
+                draw_fn(frame);
+                frame.viewport_area = full;
+                if let Some(frozen) = &screen.frozen {
+                    append_buffer(frame.buffer_mut(), frozen);
+                }
+                unselected = Some(frame.buffer_mut().clone());
+                if let Some(selection) = self.text_selection {
+                    selection.highlight(frame.buffer_mut());
+                }
+            })?;
+            if screen.frozen.is_none() {
+                screen.displayed_history_revision = screen.history_revision;
+            }
+            self.last_drawn_viewport = unselected;
+            #[cfg(unix)]
+            self.suspend_context
+                .set_cursor_y(full.height.saturating_sub(1));
+            Ok::<(), io::Error>(())
+        })??;
+        Ok(())
+    }
+}
