+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(super) enum PrintRoute {
+    CupsLp,
+    CupsLpr,
+    WindowsDefault,
+}
+
+impl PrintRoute {
+    pub(super) fn label(self) -> &'static str {
+        match self {
+            Self::CupsLp | Self::CupsLpr => "the default CUPS printer",
+            Self::WindowsDefault => "the Windows default printer",
+        }
+    }
+}
+
+#[derive(Debug)]
+pub(super) struct PrintSubmission {
+    pub(super) document_path: PathBuf,
+    pub(super) route: PrintRoute,
+    pub(super) statement_count: usize,
+}
+
+impl App {
+    pub(super) async fn print_assistant_statements(
+        &mut self,
+        previous_count: usize,
+    ) -> Result<PrintSubmission, String> {
+        let statements = select_assistant_statements(&self.transcript_cells, previous_count)?;
+        let codex_home = self.config.codex_home.to_path_buf();
+        tokio::task::spawn_blocking(move || submit_print_job(&codex_home, &statements))
+            .await
+            .map_err(|error| format!("print worker ended unexpectedly: {error}"))?
+    }
+}
+
+/// Select the newest finalized assistant statement and `previous_count` earlier cards.
+///
+/// Returned statements preserve their conversation order so a multi-card job reads from
+/// the earliest selected response through the newest one.
+pub(super) fn select_assistant_statements(
+    cells: &[Arc<dyn HistoryCell>],
+    previous_count: usize,
+) -> Result<Vec<String>, String> {
+    let requested = previous_count
+        .checked_add(1)
+        .ok_or_else(|| "statement count is too large".to_string())?;
+    let mut statements = cells
+        .iter()
+        .rev()
+        .filter_map(|cell| {
+            cell.as_any()
+                .downcast_ref::<AgentMarkdownCell>()
+                .map(AgentMarkdownCell::markdown_source)
+        })
+        .take(requested)
+        .map(ToOwned::to_owned)
+        .collect::<Vec<_>>();
+    statements.reverse();
+    if statements.is_empty() {
+        Err("no finalized assistant statement cards are available to print".to_string())
+    } else {
+        Ok(statements)
+    }
+}
+
+pub(super) fn render_print_document(statements: &[String]) -> String {
+    let count = statements.len();
+    let card_html = statements
+        .iter()
+        .enumerate()
+        .map(|(index, statement)| {
+            let position = index + 1;
+            let rendered = crate::clipboard_html::render_markdown(statement);
+            format!(
+                r#"<section class="statement">
+  <div class="statement-label">Assistant statement {position} of {count}</div>
+  <div class="statement-body">{rendered}</div>
+</section>"#
+            )
+        })
+        .collect::<Vec<_>>()
+        .join("\n");
+    let noun = if count == 1 {
+        "statement"
+    } else {
+        "statements"
+    };
+    format!(
+        r#"<!doctype html>
