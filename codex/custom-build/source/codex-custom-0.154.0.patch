+
+fn submit_print_job(codex_home: &Path, statements: &[String]) -> Result<PrintSubmission, String> {
+    let document = render_print_document(statements);
+    let document_path = write_print_document(codex_home, &document)?;
+    let route = select_print_route(
+        executable_on_path("lp"),
+        executable_on_path("lpr"),
+        windows_printing_available(),
+    )?;
+    submit_document(route, &document_path)?;
+    Ok(PrintSubmission {
+        document_path,
+        route,
+        statement_count: statements.len(),
+    })
+}
+
+fn write_print_document(codex_home: &Path, document: &str) -> Result<PathBuf, String> {
+    let directory = codex_home.join(PRINT_DIRECTORY);
+    std::fs::create_dir_all(&directory)
+        .map_err(|error| format!("could not create {}: {error}", directory.display()))?;
+    let mut file = tempfile::Builder::new()
+        .prefix("assistant-statements-")
+        .suffix(".html")
+        .tempfile_in(&directory)
+        .map_err(|error| format!("could not create print document: {error}"))?;
+    file.write_all(document.as_bytes())
+        .map_err(|error| format!("could not write print document: {error}"))?;
+    file.flush()
+        .map_err(|error| format!("could not finish print document: {error}"))?;
+    let (_file, path) = file
+        .keep()
+        .map_err(|error| format!("could not retain print document: {}", error.error))?;
+    Ok(path)
+}
+
+fn select_print_route(
+    lp_available: bool,
+    lpr_available: bool,
+    windows_printing_available: bool,
+) -> Result<PrintRoute, String> {
+    if lp_available {
+        Ok(PrintRoute::CupsLp)
+    } else if lpr_available {
+        Ok(PrintRoute::CupsLpr)
+    } else if windows_printing_available {
+        Ok(PrintRoute::WindowsDefault)
+    } else {
+        Err(
+            "no printer backend is available; configure CUPS (`lp` or `lpr`) or use WSL with Windows PowerShell"
+                .to_string(),
+        )
+    }
+}
+
+fn submit_document(route: PrintRoute, document_path: &Path) -> Result<(), String> {
+    match route {
+        PrintRoute::CupsLp => run_print_command(
+            "lp",
+            [
+                OsStr::new("-o"),
+                OsStr::new("fit-to-page"),
+                OsStr::new("-o"),
+                OsStr::new("media=A4"),
+                document_path.as_os_str(),
+            ],
+        ),
+        PrintRoute::CupsLpr => run_print_command("lpr", [document_path.as_os_str()]),
+        PrintRoute::WindowsDefault => run_windows_print(document_path),
+    }
+}
+
+fn run_print_command<'a>(
+    program: &str,
+    args: impl IntoIterator<Item = &'a OsStr>,
+) -> Result<(), String> {
+    let output = Command::new(program)
+        .args(args)
+        .output()
+        .map_err(|error| format!("could not start {program}: {error}"))?;
+    if output.status.success() {
+        Ok(())
+    } else {
+        let stderr = String::from_utf8_lossy(&output.stderr).trim().to_string();
+        if stderr.is_empty() {
+            Err(format!("{program} exited with status {}", output.status))
+        } else {
+            Err(format!("{program} failed: {stderr}"))
+        }
+    }
+}
+
+fn run_windows_print(document_path: &Path) -> Result<(), String> {
+    let windows_path = windows_document_path(document_path)?;
+    let mut child = Command::new("powershell.exe")
+        .stdin(Stdio::piped())
+        .stdout(Stdio::null())
+        .stderr(Stdio::piped())
+        .args([
+            "-STA",
+            "-NoProfile",
+            "-NonInteractive",
+            "-Command",
+            WINDOWS_PRINT_SCRIPT,
+        ])
+        .spawn()
+        .map_err(|error| format!("could not start Windows printing: {error}"))?;
+    let Some(mut stdin) = child.stdin.take() else {
+        let _ = child.kill();
+        let _ = child.wait();
+        return Err("could not open Windows printing input".to_string());
+    };
+    if let Err(error) = stdin.write_all(windows_path.as_bytes()) {
+        let _ = child.kill();
+        let _ = child.wait();
+        return Err(format!(
+            "could not send the document path to Windows printing: {error}"
+        ));
+    }
+    drop(stdin);
+    let output = child
+        .wait_with_output()
+        .map_err(|error| format!("could not wait for Windows printing: {error}"))?;
+    if output.status.success() {
+        Ok(())
+    } else {
+        let stderr = String::from_utf8_lossy(&output.stderr).trim().to_string();
+        if stderr.is_empty() {
+            Err(format!(
+                "Windows printing exited with status {}",
+                output.status
+            ))
+        } else {
+            Err(format!("Windows printing failed: {stderr}"))
+        }
+    }
+}
+
+#[cfg(target_os = "linux")]
+fn windows_document_path(document_path: &Path) -> Result<String, String> {
+    let output = Command::new("wslpath")
+        .arg("-w")
+        .arg(document_path)
+        .output()
+        .map_err(|error| format!("could not convert print document for Windows: {error}"))?;
+    if !output.status.success() {
+        let stderr = String::from_utf8_lossy(&output.stderr).trim().to_string();
+        return Err(if stderr.is_empty() {
+            format!("wslpath exited with status {}", output.status)
+        } else {
+            format!("wslpath failed: {stderr}")
+        });
+    }
+    let path = String::from_utf8(output.stdout)
+        .map_err(|_| "wslpath returned a non-UTF-8 Windows path".to_string())?;
+    let path = path.trim();
+    if path.is_empty() {
+        Err("wslpath returned an empty Windows path".to_string())
+    } else {
+        Ok(path.to_string())
+    }
+}
+
+#[cfg(target_os = "windows")]
+fn windows_document_path(document_path: &Path) -> Result<String, String> {
+    Ok(document_path.to_string_lossy().into_owned())
+}
+
+#[cfg(not(any(target_os = "linux", target_os = "windows")))]
+fn windows_document_path(_document_path: &Path) -> Result<String, String> {
+    Err("Windows printing is unavailable on this platform".to_string())
+}
+
+fn executable_on_path(program: &str) -> bool {
+    std::env::var_os("PATH").is_some_and(|path| {
+        std::env::split_paths(&path).any(|directory| directory.join(program).is_file())
+    })
+}
+
+fn windows_printing_available() -> bool {
+    (cfg!(target_os = "windows") || is_wsl_session()) && executable_on_path("powershell.exe")
+}
+
+#[cfg(target_os = "linux")]
+fn is_wsl_session() -> bool {
+    crate::clipboard_paste::is_probably_wsl()
+}
+
+#[cfg(not(target_os = "linux"))]
+fn is_wsl_session() -> bool {
+    false
+}
