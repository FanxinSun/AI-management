+#[test]
+fn neutral_panel_text_is_gently_softened_without_dimming_syntax_colors() {
+    for colors in [
+        DefaultColors {
+            fg: (240, 240, 240),
+            bg: (0, 0, 0),
+        },
+        DefaultColors {
+            fg: (31, 35, 40),
+            bg: (255, 255, 255),
+        },
+    ] {
+        with_test_default_colors(colors, || {
+            let rows = TranscriptCodeBlock::new(/*width*/ 40).render(vec![
+                Line::from(vec![
+                    Span::raw("default "),
+                    "reset ".reset(),
+                    "white ".white(),
+                    "color".green(),
+                ]),
+                Line::from("inherited").fg(Color::Rgb(240, 242, 244)),
+            ]);
+            let spans = &rows[2].spans;
+            let text_styles: Vec<_> = spans
+                .iter()
+                .filter(|span| !span.content.trim().is_empty())
+                .map(|span| span.style)
+                .collect();
+            assert_eq!(text_styles[0].fg, text_styles[1].fg);
+            assert_eq!(text_styles[0].fg, text_styles[2].fg);
+            assert_eq!(text_styles[3].fg, Some(Color::Green));
+            assert!(!text_styles[0].add_modifier.contains(Modifier::DIM));
+            let Some(Color::Rgb(r, g, b)) = text_styles[0].fg else {
+                panic!("neutral text must have an explicit softened foreground");
+            };
+            for (actual, original) in
+                [r, g, b]
+                    .into_iter()
+                    .zip([colors.fg.0, colors.fg.1, colors.fg.2])
+            {
+                if is_light(colors.bg) {
+                    assert!(actual > original && actual - original < 35);
+                } else {
+                    assert!(actual < original && original - actual < 35);
+                }
+            }
+            let inherited = rows[3]
+                .spans
+                .iter()
+                .find(|span| span.content == "inherited")
+                .unwrap();
+            assert_ne!(inherited.style.fg, Some(Color::Rgb(240, 242, 244)));
+        });
+    }
