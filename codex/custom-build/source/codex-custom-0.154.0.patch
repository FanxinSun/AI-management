+#[test]
+fn history_selection_restores_before_output_and_drops_stale_resize_coordinates() {
+    let size = Size::new(/*width*/ 20, /*height*/ 6);
+    let mut terminal = Terminal::with_screen_size_and_cursor_position_for_test(
+        VT100Backend::new(size.width, size.height),
+        size,
+        Position::new(/*x*/ 0, /*y*/ 5),
+    );
+    terminal.set_viewport_area(Rect::new(
+        /*x*/ 0, /*y*/ 4, /*width*/ 20, /*height*/ 2,
+    ));
+    let mut surface = Buffer::empty(Rect::new(
+        /*x*/ 0, /*y*/ 0, /*width*/ 20, /*height*/ 6,
+    ));
+    surface.set_string(/*x*/ 0, /*y*/ 0, "old text", Style::default());
+    let mut selection = TextSelection::new(Position::new(/*x*/ 0, /*y*/ 0));
+    selection.update(Position::new(/*x*/ 7, /*y*/ 0));
+    let mut overlay = HistorySelection::default();
+    overlay
+        .paint(&mut terminal, &surface, Some(selection))
+        .unwrap();
+    overlay.restore(&mut terminal, size).unwrap();
+    write!(terminal.backend_mut(), "\x1b[1;1Hnew text").unwrap();
+    overlay.restore(&mut terminal, size).unwrap();
+    assert_eq!(terminal.backend().vt100().screen().contents(), "new text");
+
+    overlay
+        .paint(&mut terminal, &surface, Some(selection))
+        .unwrap();
+    write!(terminal.backend_mut(), "\x1b[0m\x1b[1;1Hreflowed").unwrap();
+    overlay
+        .restore(&mut terminal, Size::new(/*width*/ 30, /*height*/ 6))
+        .unwrap();
+    assert_eq!(terminal.backend().vt100().screen().contents(), "reflowed");
+}
