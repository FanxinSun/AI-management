+//! Application-owned conversation display, scrolling and selection.
+//!
+//! History and composer share one ratatui frame. No selection operation writes cached characters
+//! into terminal-owned scrollback. A gesture reads the unhighlighted frame the user actually saw;
+//! streaming may update the history underneath, but cannot move the selected text during the drag.
+
+use super::*;
+use crossterm::event::KeyCode;
+use crossterm::event::KeyEventKind;
+use crossterm::event::KeyModifiers;
+
+#[cfg(test)]
+#[path = "conversation_screen_tests.rs"]
+mod tests;
+
+#[derive(Default)]
+pub(super) struct ConversationScreen {
+    pub(super) overlay: bool,
+    pub(super) history_area: Rect,
+    pub(super) offset: usize,
+    pub(super) frozen: Option<Buffer>,
+    pub(super) history_revision: u64,
+    pub(super) displayed_history_revision: u64,
+}
