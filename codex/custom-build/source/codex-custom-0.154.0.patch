+#[test]
+fn finalized_markdown_transcript_frames_fenced_code_without_literal_backticks() {
+    let cell = AgentMarkdownCell::new(
+        "Before\n\n```rust\nfn main() {}\n```\nAfter".to_string(),
+        Path::new("/tmp"),
+    );
+
+    let rendered = cell
+        .transcript_hyperlink_lines(/*width*/ 80)
+        .iter()
+        .map(|line| {
+            line.line
+                .spans
+                .iter()
+                .map(|span| span.content.as_ref())
+                .collect::<String>()
+        })
+        .collect::<Vec<_>>();
+
+    let header = rendered
+        .iter()
+        .position(|line| line.trim() == "bash")
+        .expect("native code-frame header");
+    let body = rendered
+        .iter()
+        .position(|line| line.trim() == "fn main() {}")
+        .expect("native code-frame body");
+    let footer = rendered
+        .iter()
+        .rposition(|line| line.trim() == "After")
+        .expect("prose after code block");
