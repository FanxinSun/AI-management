+//! Ctrl+End must reach the owned conversation without changing the user's draft.
+use super::*;
+use crossterm::event::MouseEventKind;
+use pretty_assertions::assert_eq;
+use ratatui::layout::Size;
+
+#[tokio::test]
+async fn ctrl_end_routes_through_app_to_latest_history_and_preserves_draft() -> Result<()> {
+    let (mut app, _events, _ops) = Box::pin(make_test_app_with_channels()).await;
+    let mut server = start_config_write_test_app_server(&app).await?;
+    let mut tui = crate::tui::test_support::make_test_tui()?;
+    tui.enable_conversation_screen()?;
+    Box::pin(app.handle_tui_event(
+        &mut tui,
+        &mut server,
+        TuiEvent::Paste("keep my draft".into()),
+    ))
+    .await?;
+    tui.insert_history_lines(
+        (0..40)
+            .map(|i| Line::from(format!("history {i}")))
+            .collect(),
+    );
+    let draw = |tui: &mut crate::tui::Tui| {
+        tui.draw_with_resize_reflow(
+            /*height*/ 2,
+            Size::new(/*width*/ 80, /*height*/ 24),
+            |_| {},
+        )
+    };
+    draw(&mut tui)?;
+    for _ in 0..2 {
+        tui.scroll_conversation(MouseEventKind::ScrollUp);
+        draw(&mut tui)?;
+        assert_eq!(
+            tui.history_tail_row_index_at_screen_row(/*screen_row*/ 21),
+            Some(36)
+        );
+        Box::pin(app.handle_tui_event(
+            &mut tui,
+            &mut server,
+            TuiEvent::Key(KeyEvent::new(KeyCode::End, KeyModifiers::CONTROL)),
+        ))
+        .await?;
+        draw(&mut tui)?;
+        assert_eq!(
+            tui.history_tail_row_index_at_screen_row(/*screen_row*/ 21),
+            Some(39)
+        );
+        assert_eq!(
+            app.chat_widget.composer_text_with_pending(),
+            "keep my draft"
+        );
+    }
+    Ok(())
+}
