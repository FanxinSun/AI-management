+/// Bound the interactive conversation row cache. Full transcript source stays with the app.
+const TEXT_SELECTION_HISTORY_ROW_LIMIT: usize = 16_384;
+
+/// A screen-coordinate selection owned by the Codex TUI.
+///
+/// Terminal mouse tracking prevents the emulator from creating its native selection, so selection
+/// has to be modeled against Codex's rendered cell buffer. A short press-and-release is left for
+/// existing click controls; only a real drag becomes a text selection.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+struct TextSelection {
+    anchor: Position,
+    focus: Position,
+    dragged: bool,
+}
+
+impl TextSelection {
+    fn new(position: Position) -> Self {
+        Self {
+            anchor: position,
+            focus: position,
+            dragged: false,
+        }
+    }
+
+    fn update(&mut self, position: Position) {
+        self.focus = position;
+        self.dragged |= position != self.anchor;
+    }
+
+    fn ordered_bounds(self) -> (Position, Position) {
+        if (self.anchor.y, self.anchor.x) <= (self.focus.y, self.focus.x) {
+            (self.anchor, self.focus)
+        } else {
+            (self.focus, self.anchor)
+        }
+    }
+
+    fn contains(self, position: Position) -> bool {
+        if !self.dragged {
+            return false;
+        }
+        let (start, end) = self.ordered_bounds();
+        if position.y < start.y || position.y > end.y {
+            return false;
+        }
+        if start.y == end.y {
+            return position.x >= start.x && position.x <= end.x;
+        }
+        if position.y == start.y {
+            return position.x >= start.x;
+        }
+        if position.y == end.y {
+            return position.x <= end.x;
+        }
+        true
+    }
+
+    fn highlight(self, buffer: &mut Buffer) {
+        if !self.dragged {
+            return;
+        }
+        let area = buffer.area;
+        for y in area.top()..area.bottom() {
+            for x in area.left()..area.right() {
+                if self.contains(Position { x, y }) {
+                    let cell = &mut buffer[(x, y)];
+                    cell.modifier.insert(Modifier::REVERSED);
+                    // Keep forced widths on hyperlinks and skip flags on wide-character tails.
+                    // Changing them would let escape bytes distort terminal cell coordinates.
+                }
+            }
+        }
+    }
+}
