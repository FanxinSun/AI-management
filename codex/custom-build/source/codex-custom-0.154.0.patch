index 0000000..feeb7fa
--- /dev/null
+++ b/codex-rs/tui/src/tui/history_selection.rs
@@ -0,0 +1,96 @@
+//! Paint drag selection in committed history, which lies outside the inline frame buffer.
+//!
+//! Restore the original cells before history insertion or viewport movement. Otherwise a later
+//! drag can leave highlighted cells behind, or restore old text over newly streamed output.
+
+use std::io;
+use std::io::Write;
+
+use ratatui::backend::Backend;
+use ratatui::buffer::Buffer;
+use ratatui::layout::Rect;
+use ratatui::layout::Size;
+
+use super::TextSelection;
+use super::append_buffer;
+use crate::custom_terminal::Terminal;
+
+#[derive(Default)]
+pub(super) struct HistorySelection {
+    painted: Option<PaintedHistory>,
+}
+
+struct PaintedHistory {
+    original: Buffer,
+    highlighted: Buffer,
+    screen_size: Size,
+}
+
+impl HistorySelection {
+    /// Remove the overlay before any underlying history is changed or moved.
+    pub(super) fn restore<B>(
+        &mut self,
+        terminal: &mut Terminal<B>,
+        screen_size: Size,
+    ) -> io::Result<()>
+    where
+        B: Backend<Error = io::Error> + Write,
+    {
+        let Some(painted) = self.painted.take() else {
+            return Ok(());
+        };
+        // Resize reflow owns the screen after a geometry change. Old coordinates are invalid.
+        if painted.screen_size != screen_size {
+            return Ok(());
+        }
+        let cursor = terminal.last_known_cursor_pos;
+        let backend = terminal.backend_mut();
+        backend.draw(painted.highlighted.diff(&painted.original).into_iter())?;
+        backend.set_cursor_position(cursor)?;
+        Backend::flush(backend)
+    }
+
+    /// Paint only history; the inline frame renders its own part of the same selection.
+    pub(super) fn paint<B>(
+        &mut self,
+        terminal: &mut Terminal<B>,
+        surface: &Buffer,
+        selection: Option<TextSelection>,
+    ) -> io::Result<()>
+    where
+        B: Backend<Error = io::Error> + Write,
+    {
+        let Some(selection) = selection.filter(|selection| selection.dragged) else {
+            return Ok(());
+        };
+        let (start, end) = selection.ordered_bounds();
+        let bottom = end.y.saturating_add(1).min(terminal.viewport_area.top());
+        if start.y >= bottom {
+            return Ok(());
+        }
+        let mut original = Buffer::empty(Rect::new(
+            /*x*/ 0,
+            start.y,
+            surface.area.width,
+            bottom - start.y,
+        ));
+        append_buffer(&mut original, surface);
+        let mut highlighted = original.clone();
+        selection.highlight(&mut highlighted);
+        let cursor = terminal.last_known_cursor_pos;
+        let backend = terminal.backend_mut();
+        backend.draw(original.diff(&highlighted).into_iter())?;
+        backend.set_cursor_position(cursor)?;
+        Backend::flush(backend)?;
+        self.painted = Some(PaintedHistory {
+            original,
+            highlighted,
+            screen_size: terminal.last_known_screen_size,
+        });
+        Ok(())
+    }
+}
+
+#[cfg(test)]
