new file mode 100644
index 0000000..bf4b6b0
--- /dev/null
+++ b/codex-rs/tui/src/transcript_code_block.rs
@@ -0,0 +1,108 @@
+//! Shared, padded code panels for the transcript's commands and message code.
+//!
+//! The background is painted on spans, including the right-hand padding, so it
+//! survives viewport scrolling without coloring adjacent prose or outer margins.
+
+use crate::color::blend;
+use crate::color::is_light;
+use crate::terminal_palette::default_bg;
+use crate::terminal_palette::default_fg;
+use crate::wrapping::RtOptions;
+use crate::wrapping::word_wrap_lines;
+use ratatui::style::Color;
+use ratatui::style::Style;
+use ratatui::style::Stylize;
+use ratatui::text::Line;
+use ratatui::text::Span;
+
+pub(crate) struct TranscriptCodeBlock {
+    width: usize,
+    inset: usize,
+}
+
+impl TranscriptCodeBlock {
+    pub(crate) fn new(width: usize) -> Self {
+        let width = width.max(1);
+        Self {
+            width,
+            inset: 2.min(width.saturating_sub(1) / 4),
+        }
+    }
+
+    pub(crate) fn content_width(&self) -> usize {
+        self.width - 4 * self.inset
+    }
+
+    pub(crate) fn render(&self, content: Vec<Line<'static>>) -> Vec<Line<'static>> {
+        let light = default_bg().is_some_and(is_light);
+        let background = if light { (239, 241, 243) } else { (28, 30, 34) };
+        let foreground = default_fg().unwrap_or(if light { (31, 35, 40) } else { (255, 255, 255) });
+        let panel_style = Style::default()
+            .bg(Color::Rgb(background.0, background.1, background.2))
+            .not_bold();
+        let content = word_wrap_lines(&content, RtOptions::new(self.content_width()));
+        // Raw/export callers request an unbounded width. Avoid allocating a
+        // terminal-sized padding run for each line in that case.
+        let panel_width = if self.width == u16::MAX as usize {
+            content.iter().map(Line::width).max().unwrap_or(0).max(4) + 2 * self.inset
+        } else {
+            self.width - 2 * self.inset
+        };
+        let mut rows = word_wrap_lines(
+            [Line::from("bash".cyan().dim())],
+            RtOptions::new(self.content_width()),
+        );
+        rows.push(Line::default());
+        rows.extend(content);
+        rows.push(Line::default());
+        rows.into_iter()
+            .map(|row| {
+                let used = row.width() + self.inset;
+                let mut spans = vec![
+                    Span::raw(" ".repeat(self.inset)),
+                    Span::styled(" ".repeat(self.inset), panel_style),
+                ];
+                spans.extend(row.spans.into_iter().map(|mut span| {
+                    span.style = row.style.patch(span.style).patch(panel_style);
+                    // Soften neutral text slightly without ANSI DIM's much
+                    // stronger reduction or changing syntax/diagnostic colors.
+                    let neutral = match span.style.fg {
+                        None
+                        | Some(
+                            Color::Reset
+                            | Color::White
+                            | Color::Gray
+                            | Color::Indexed(7 | 15 | 231),
+                        ) => Some(foreground),
+                        Some(Color::Rgb(r, g, b))
+                            if r.min(g).min(b) >= 180
+                                && r.max(g).max(b) - r.min(g).min(b) <= 24 =>
+                        {
+                            Some((r, g, b))
+                        }
+                        Some(Color::Indexed(index @ 249..=255)) => {
+                            let value = 8 + 10 * (index - 232);
+                            Some((value, value, value))
+                        }
+                        Some(_) => None,
+                    };
+                    if let Some(neutral) = neutral {
+                        let (r, g, b) = blend(neutral, background, /*alpha*/ 0.88);
+                        span.style = span.style.fg(Color::Rgb(r, g, b));
+                    }
+                    span
+                }));
+                spans.push(Span::styled(
+                    " ".repeat(panel_width.saturating_sub(used)),
+                    panel_style,
+                ));
+                spans.push(Span::raw(" ".repeat(self.inset)));
+                Line::from(spans)
+            })
+            .collect()
+    }
+}
+
+#[cfg(test)]
+#[path = "transcript_code_block_tests.rs"]
+mod tests;
