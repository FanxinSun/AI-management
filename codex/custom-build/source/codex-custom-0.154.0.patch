+/// Enable the complete mouse-reporting mode set used by Crossterm.
+///
+/// Normal press/release (`1000`), button drag (`1002`), any motion (`1003`), RXVT compatibility
+/// (`1015`), and SGR coordinates (`1006`) are emitted in Crossterm's standard order. The input
+/// stream discards unbuttoned motion while retaining presses, releases, drags, and wheel turns.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+struct EnableClickCapture;
+
+impl Command for EnableClickCapture {
+    fn write_ansi(&self, f: &mut impl fmt::Write) -> fmt::Result {
+        write!(f, "\x1b[?1000h\x1b[?1002h\x1b[?1003h\x1b[?1015h\x1b[?1006h")
+    }
+
+    #[cfg(windows)]
+    fn execute_winapi(&self) -> Result<()> {
+        Err(std::io::Error::other(
+            "tried to execute EnableClickCapture using WinAPI; use ANSI instead",
+        ))
+    }
+
+    #[cfg(windows)]
+    fn is_ansi_code_supported(&self) -> bool {
+        true
+    }
+}
+
+/// Disable every conventional mouse-reporting mode.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+struct DisableClickCapture;
+
