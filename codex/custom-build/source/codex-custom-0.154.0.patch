+
+fn buffer_for(lines: &[HyperlinkLine], width: u16, height: u16, scroll: u16) -> Buffer {
+    let area = Rect::new(/*x*/ 0, /*y*/ 0, width, height);
+    let mut buffer = Buffer::empty(area);
+    HyperlinkParagraph::new(lines, Style::default())
+        .scroll(scroll)
+        .render(area, &mut buffer);
+    buffer
+}
+
+fn snapshot(buffer: &Buffer) -> String {
+    let mut text = String::new();
+    for y in 0..buffer.area.height {
+        let content: String = (0..buffer.area.width)
+            .map(|x| buffer[(x, y)].symbol())
+            .collect();
+        let fill: String = (0..buffer.area.width)
+            .map(|x| {
+                if buffer[(x, y)].bg == Color::Reset {
+                    '.'
+                } else {
+                    '#'
+                }
+            })
+            .collect();
+        text.push_str(&format!("{content}\n{fill}\n"));
+    }
+    text
+}
