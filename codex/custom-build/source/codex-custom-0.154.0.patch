+#[test]
+fn history_drag_is_visible_and_second_selection_restores_the_first() {
+    let size = Size::new(/*width*/ 20, /*height*/ 6);
+    let cursor = Position::new(/*x*/ 2, /*y*/ 5);
+    let mut terminal = Terminal::with_screen_size_and_cursor_position_for_test(
+        VT100Backend::new(size.width, size.height),
+        size,
+        cursor,
+    );
+    terminal.set_viewport_area(Rect::new(
+        /*x*/ 0, /*y*/ 4, /*width*/ 20, /*height*/ 2,
+    ));
+    let mut surface = Buffer::empty(Rect::new(
+        /*x*/ 0, /*y*/ 0, /*width*/ 20, /*height*/ 6,
+    ));
+    surface.set_string(
+        /*x*/ 2,
+        /*y*/ 0,
+        "alpha history",
+        Style::default(),
+    );
+    surface.set_string(
+        /*x*/ 2,
+        /*y*/ 1,
+        "bravo history",
+        Style::default(),
+    );
+    surface.set_string(/*x*/ 2, /*y*/ 4, "prompt", Style::default());
+    let blank = Buffer::empty(surface.area);
+    terminal
+        .backend_mut()
+        .draw(blank.diff(&surface).into_iter())
+        .expect("paint conversation and prompt");
+    terminal.set_cursor_position(cursor).expect("place cursor");
+
+    let mut overlay = HistorySelection::default();
+    let mut first = TextSelection::new(Position::new(/*x*/ 2, /*y*/ 0));
+    first.update(Position::new(/*x*/ 6, /*y*/ 0));
+    overlay.paint(&mut terminal, &surface, Some(first)).unwrap();
+    let screen = terminal.backend().vt100().screen();
+    assert!(screen.cell(/*row*/ 0, /*col*/ 2).unwrap().inverse());
+    assert!(!screen.cell(/*row*/ 0, /*col*/ 7).unwrap().inverse());
+    assert!(!screen.cell(/*row*/ 4, /*col*/ 2).unwrap().inverse());
+    assert_eq!(screen.cursor_position(), (5, 2));
+    insta::assert_snapshot!(
+        (0..6)
+            .map(|row| (0..20)
+                .map(|col| {
+                    let cell = screen.cell(row, col).unwrap();
+                    if cell.inverse() { '^' } else { '.' }
+                })
+                .collect::<String>())
+            .collect::<Vec<_>>()
+            .join("\n"),
+        @"
+        ..^^^^^.............
+        ....................
+        ....................
+        ....................
+        ....................
+        ....................
+        "
+    );
+
+    overlay.restore(&mut terminal, size).unwrap();
+    let mut second = TextSelection::new(Position::new(/*x*/ 2, /*y*/ 1));
+    second.update(Position::new(/*x*/ 6, /*y*/ 1));
+    overlay
+        .paint(&mut terminal, &surface, Some(second))
+        .unwrap();
+    let screen = terminal.backend().vt100().screen();
+    assert!(!screen.cell(/*row*/ 0, /*col*/ 2).unwrap().inverse());
+    assert!(screen.cell(/*row*/ 1, /*col*/ 2).unwrap().inverse());
+    assert_eq!(
+        [first, second].map(|selection| selected_text_from_buffer(selection, &surface)),
+        [Some("alpha".to_string()), Some("bravo".to_string())]
+    );
+    overlay.restore(&mut terminal, size).unwrap();
+    assert!(
+        !terminal
+            .backend()
+            .vt100()
+            .screen()
+            .cell(1, 2)
+            .unwrap()
+            .inverse()
+    );
+    assert_eq!(
+        terminal.backend().vt100().screen().contents(),
+        "  alpha history\n  bravo history\n\n\n  prompt"
+    );
+}
